table table_health_snapshots
	lineageTag: b5b65f36-bf29-5a88-81f7-da908f40486a

	measure 'Latest Snapshot' =
			CALCULATE ( MAX ( table_health_snapshots[snapshot_ts] ), REMOVEFILTERS ( table_health_snapshots[snapshot_ts] ), REMOVEFILTERS ( table_health_snapshots[status] ), REMOVEFILTERS ( table_health_snapshots[table] ) )
		displayFolder: Helpers
		lineageTag: dc7b5bf8-106b-5927-9a0d-f3b8f2674e31

	measure 'Tables' =
			VAR __ls = [Latest Snapshot]
			RETURN COALESCE ( CALCULATE ( COUNTROWS ( SUMMARIZE ( table_health_snapshots, table_health_snapshots[workspace], table_health_snapshots[lakehouse], table_health_snapshots[table] ) ), table_health_snapshots[snapshot_ts] = __ls ), 0 )
		displayFolder: KPI
		lineageTag: b864d8cb-e9db-5c2f-945a-9f7eaa694d7a

	measure 'Healthy' =
			VAR __ls = [Latest Snapshot]
			RETURN COALESCE ( CALCULATE ( COUNTROWS ( SUMMARIZE ( table_health_snapshots, table_health_snapshots[workspace], table_health_snapshots[lakehouse], table_health_snapshots[table] ) ), table_health_snapshots[snapshot_ts] = __ls, KEEPFILTERS ( table_health_snapshots[status] = "healthy" ) ), 0 )
		displayFolder: KPI
		lineageTag: 400a2fb0-a218-58d8-ad37-1725221022f4

	measure 'Unhealthy' =
			VAR __ls = [Latest Snapshot]
			RETURN COALESCE ( CALCULATE ( COUNTROWS ( SUMMARIZE ( table_health_snapshots, table_health_snapshots[workspace], table_health_snapshots[lakehouse], table_health_snapshots[table] ) ), table_health_snapshots[snapshot_ts] = __ls, KEEPFILTERS ( table_health_snapshots[status] = "unhealthy" ) ), 0 )
		displayFolder: KPI
		lineageTag: 33e87006-0910-5419-933b-3afc39e8ffde

	measure 'Unknown' =
			VAR __ls = [Latest Snapshot]
			RETURN COALESCE ( CALCULATE ( COUNTROWS ( SUMMARIZE ( table_health_snapshots, table_health_snapshots[workspace], table_health_snapshots[lakehouse], table_health_snapshots[table] ) ), table_health_snapshots[snapshot_ts] = __ls, KEEPFILTERS ( table_health_snapshots[status] = "unknown" ) ), 0 )
		displayFolder: KPI
		lineageTag: 371d362f-2baf-5ec6-815f-fc4733f19cb7

	measure 'Healthy %' =
			DIVIDE ( [Healthy], [Tables] )
		formatString: 0.0%
		displayFolder: KPI
		lineageTag: 446c7ba4-8010-5376-96ce-7cf8be9389b2

	measure 'Anomaly Code' =
			VAR __ls = [Latest Snapshot]
			RETURN CALCULATE ( MAX ( table_health_snapshots[PotentialAnomalyType] ), table_health_snapshots[snapshot_ts] = __ls )
		formatString: 0
		displayFolder: Per table
		lineageTag: adff8cdd-35d2-5f1c-a596-c3b7e5f76a60

	measure 'Anomaly Reason' =
			VAR __ls = [Latest Snapshot]
			RETURN CALCULATE ( SELECTEDVALUE ( table_health_snapshots[PotentialAnomalyDescription] ), table_health_snapshots[snapshot_ts] = __ls )
		displayFolder: Per table
		lineageTag: 7678edb3-0875-51e0-ab2b-cb0ed7451c79

	measure 'Health Status' =
			VAR __ls = [Latest Snapshot]
			RETURN CALCULATE ( SELECTEDVALUE ( table_health_snapshots[status] ), table_health_snapshots[snapshot_ts] = __ls )
		displayFolder: Per table
		lineageTag: 8190c2c4-e402-55e9-af7a-9f23e17d5a78

	measure 'Files' =
