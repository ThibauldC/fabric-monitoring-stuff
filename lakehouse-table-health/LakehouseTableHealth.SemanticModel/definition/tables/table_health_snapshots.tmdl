		formatString: #,0.0
		displayFolder: Per table
		lineageTag: e38fd525-2407-5ac7-b677-1c83d68f2630

	measure 'Rows' =
			VAR __ls = [Latest Snapshot]
			RETURN CALCULATE ( SUM ( table_health_snapshots[PhysicalRowCount] ), table_health_snapshots[snapshot_ts] = __ls )
		formatString: #,0
		displayFolder: Per table
