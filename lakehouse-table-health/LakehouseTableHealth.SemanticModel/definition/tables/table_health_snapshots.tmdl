			RETURN CALCULATE ( SUM ( table_health_snapshots[FileCount] ), table_health_snapshots[snapshot_ts] = __ls )
		formatString: #,0
		displayFolder: Per table
		lineageTag: ac4ab2ee-70ef-5487-8006-55ba7c2fbca5

	measure 'Size MB' =
