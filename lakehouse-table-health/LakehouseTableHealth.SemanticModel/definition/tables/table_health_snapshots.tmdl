			RETURN DIVIDE ( CALCULATE ( SUM ( table_health_snapshots[FileSizeInBytes] ), table_health_snapshots[snapshot_ts] = __ls ), 1048576 )
		formatString: #,0.0
		displayFolder: Per table
		lineageTag: 209d8cc4-ca13-555e-8e34-9a6ef7abf874

	measure 'Avg File MB' =
